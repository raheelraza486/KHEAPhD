{
  "openapi": "3.0.3",
  "info": {
    "title": "Babelway",
    "version": "1.0.0",
    "description": "Converts an invoice sent as JSON into a UBL 2.1 invoice (XML). Babelway has no fixed public API for this: an environment builds a channel (a gateway in, the definition of the message in, a transformation, the definition of the message out, a gateway out), and a channel whose gateway in is a \"REST API Server\" publishes an HTTP address that answers each call with the channel's output. What the request and the answer look like is decided by the channel.\n\nNo provider OpenAPI document exists. This one was written by the CS9-5 group from a channel it built in a 30-day trial environment on 13 October 2026, and from its own calls to it: gateway in REST API Server with \"Body of API call as message content\"; message in JSON, defined from a sample invoice; message out UBL, defined from a sample UBL invoice; a visual mapping of 60 values and one loop (invoice lines); gateway out NULL, so the result goes nowhere but back to the caller. A test invoice with two lines was answered with status 200 in about 3 seconds, and the UBL returned passed ESS SmartDocFlow's Peppol PINT A-NZ check (3 of 3). A body that was not complete JSON was answered with status 500, and a call after the channel was switched off with status 404.\n\nThe request schema is therefore the group's own test message, not a format Babelway prescribes, and the specification identifiers, tax scheme (GST) and tax category (S) in the output are constants of the group's mapping. The identifier in the path is chosen per gateway and is left as a placeholder. The address of the trial environment was on eu1.babelway.net; Babelway's help centre names ws.babelway.net.",
    "contact": {
      "name": "Babelway",
      "url": "https://www.babelway.com"
    }
  },
  "externalDocs": {
    "description": "Babelway help centre: Rest Gateway In",
    "url": "https://babelway.zendesk.com/hc/en-us/articles/15607402778396-4-2-2-14-Rest-Gateway-In"
  },
  "servers": [
    {
      "url": "https://eu1.babelway.net"
    }
  ],
  "paths": {
    "/rest/{urlIdentifier}/message.xml": {
      "post": {
        "operationId": "convertInvoiceJsonToUbl",
        "summary": "Convert an invoice sent as JSON to UBL XML",
        "description": "Sends the invoice as JSON to a channel's REST API Server gateway and receives the channel's output, a UBL 2.1 invoice, in the same call. The channel the group built maps each value of the request to its UBL element, repeats the invoice line for each item, and writes the Peppol PINT A-NZ identifiers, the GST tax scheme and tax category S as constants. Babelway also accepts PUT and PATCH, and a path ending in .json, according to its help centre; the group called POST with .xml.",
        "parameters": [
          {
            "name": "urlIdentifier",
            "in": "path",
            "required": true,
            "description": "The \"Url identifier\" set on the channel's REST API Server gateway. It is chosen per gateway; the test gateway listed no credentials, so its identifier is not published.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "The invoice. This is the message the group defined for its test channel from a sample; another channel defines its own.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The channel's output: a UBL 2.1 Invoice document.",
            "content": {
              "text/xml": {
                "schema": {
                  "type": "string",
                  "description": "A UBL 2.1 Invoice as XML, with root element Invoice in the namespace urn:oasis:names:specification:ubl:schema:xsd:Invoice-2."
                }
              }
            }
          },
          "404": {
            "description": "No active gateway has this identifier (seen after the channel was switched off).",
            "content": {
              "text/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "The body could not be read as the channel's message (seen for JSON that was cut short).",
            "content": {
              "text/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "xml": {
          "name": "error"
        },
        "required": [
          "errorCode",
          "errorMessage"
        ],
        "properties": {
          "errorCode": {
            "type": "string",
            "description": "Babelway's code for the failure. Seen: messageInError (the body could not be read as the channel's message) and unknownGateway (no active gateway has this identifier).",
            "example": "messageInError"
          },
          "errorMessage": {
            "type": "string",
            "description": "What went wrong, in words.",
            "example": "No gateway registered for : {urlIdentifier}"
          },
          "messageKey": {
            "type": "string",
            "description": "Babelway's key for the message, when one was created; absent for unknownGateway.",
            "example": "a786792b-fa0f-4164-ae45-75dacf48b35b"
          }
        }
      },
      "InvoiceRequest": {
        "type": "object",
        "required": [
          "invoiceNumber",
          "issueDate",
          "invoiceTypeCode",
          "currency",
          "supplier",
          "customer",
          "taxTotal",
          "totals",
          "items"
        ],
        "properties": {
          "invoiceNumber": {
            "type": "string",
            "description": "The invoice's number.",
            "example": "CS95-BW-0001"
          },
          "issueDate": {
            "type": "string",
            "description": "Issue date.",
            "format": "date",
            "example": "2026-10-13"
          },
          "dueDate": {
            "type": "string",
            "description": "Due date.",
            "format": "date",
            "example": "2026-11-12"
          },
          "invoiceTypeCode": {
            "type": "string",
            "description": "UNCL 1001 document type code; 380 is a commercial invoice.",
            "example": "380"
          },
          "currency": {
            "type": "string",
            "description": "The invoice's currency, as an ISO 4217 code. Written on every amount.",
            "example": "AUD"
          },
          "buyerReference": {
            "type": "string",
            "description": "The buyer's reference.",
            "example": "CS95-DEMO-REF"
          },
          "supplier": {
            "type": "object",
            "description": "The seller.",
            "required": [
              "name",
              "abn",
              "address"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "The seller's name.",
                "example": "CS9 Demo Supplies Pty Ltd"
              },
              "abn": {
                "type": "string",
                "description": "The seller's ABN, 11 digits. Used as electronic address (scheme 0151), tax registration and legal registration.",
                "example": "47555222000"
              },
              "address": {
                "type": "object",
                "description": "The seller's postal address.",
                "required": [
                  "street",
                  "city",
                  "postalCode",
                  "country"
                ],
                "properties": {
                  "street": {
                    "type": "string",
                    "description": "Street and number.",
                    "example": "1 Test Street"
                  },
                  "city": {
                    "type": "string",
                    "description": "City.",
                    "example": "Sydney"
                  },
                  "state": {
                    "type": "string",
                    "description": "State or territory.",
                    "example": "NSW"
                  },
                  "postalCode": {
                    "type": "string",
                    "description": "Postcode.",
                    "example": "2000"
                  },
                  "country": {
                    "type": "string",
                    "description": "Country, as an ISO 3166-1 alpha-2 code.",
                    "example": "AU"
                  }
                }
              }
            }
          },
          "customer": {
            "type": "object",
            "description": "The buyer.",
            "required": [
              "name",
              "address"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "The buyer's name.",
                "example": "Test PEPPOL Registered"
              },
              "abn": {
                "type": "string",
                "description": "The buyer's ABN, 11 digits. Written as legal registration (scheme 0151).",
                "example": "99000000000"
              },
              "endpointId": {
                "type": "string",
                "description": "The buyer's electronic address, a GLN (scheme 0088).",
                "example": "9508397101047"
              },
              "address": {
                "type": "object",
                "description": "The buyer's postal address.",
                "required": [
                  "street",
                  "city",
                  "postalCode",
                  "country"
                ],
                "properties": {
                  "street": {
                    "type": "string",
                    "description": "Street and number.",
                    "example": "1 Test Street"
                  },
                  "city": {
                    "type": "string",
                    "description": "City.",
                    "example": "Sydney"
                  },
                  "postalCode": {
                    "type": "string",
                    "description": "Postcode.",
                    "example": "2000"
                  },
                  "country": {
                    "type": "string",
                    "description": "Country, as an ISO 3166-1 alpha-2 code.",
                    "example": "AU"
                  }
                }
              }
            }
          },
          "taxTotal": {
            "type": "object",
            "description": "The invoice's tax.",
            "required": [
              "taxAmount",
              "taxPercent"
            ],
            "properties": {
              "taxAmount": {
                "type": "string",
                "description": "Total tax amount.",
                "example": "50.00"
              },
              "taxPercent": {
                "type": "string",
                "description": "The tax rate, in percent. Written on the tax breakdown and on every line.",
                "example": "10"
              }
            }
          },
          "paymentTerms": {
            "type": "object",
            "description": "Payment terms.",
            "properties": {
              "note": {
                "type": "string",
                "description": "The terms, in words.",
                "example": "Payable within 30 days."
              }
            }
          },
          "totals": {
            "type": "object",
            "description": "The invoice's totals.",
            "required": [
              "lineExtensionAmount",
              "taxExclusiveAmount",
              "taxInclusiveAmount",
              "payableAmount"
            ],
            "properties": {
              "lineExtensionAmount": {
                "type": "string",
                "description": "Sum of the line amounts.",
                "example": "500.00"
              },
              "taxExclusiveAmount": {
                "type": "string",
                "description": "Total without tax. Also written as the taxable amount.",
                "example": "500.00"
              },
              "taxInclusiveAmount": {
                "type": "string",
                "description": "Total with tax.",
                "example": "550.00"
              },
              "payableAmount": {
                "type": "string",
                "description": "Amount due.",
                "example": "550.00"
              }
            }
          },
          "items": {
            "type": "array",
            "description": "The invoice lines; one UBL InvoiceLine is written for each.",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "lineID",
                "description",
                "quantity",
                "unitCode",
                "unitPrice",
                "lineExtensionAmount"
              ],
              "properties": {
                "lineID": {
                  "type": "string",
                  "description": "The line's number.",
                  "example": "1"
                },
                "description": {
                  "type": "string",
                  "description": "The name of the item.",
                  "example": "API integration consulting"
                },
                "quantity": {
                  "type": "string",
                  "description": "Invoiced quantity.",
                  "example": "2"
                },
                "unitCode": {
                  "type": "string",
                  "description": "Unit of measure, as a UN/ECE Recommendation 20 code.",
                  "example": "HUR"
                },
                "unitPrice": {
                  "type": "string",
                  "description": "Price of one unit, without tax.",
                  "example": "150.00"
                },
                "lineExtensionAmount": {
                  "type": "string",
                  "description": "The line's amount, without tax.",
                  "example": "300.00"
                }
              }
            }
          }
        }
      }
    }
  }
}
