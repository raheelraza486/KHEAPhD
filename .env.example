POSTGRES_USER=cs9
POSTGRES_PASSWORD=cs9_dev_only
POSTGRES_DB=cs9

# Host port. If you already run a local Postgres (for example one installed
# through Homebrew), 5432 is taken -- set this to 5433 instead. The port
# inside the container stays 5432 either way, so nothing else changes.
# To see what is holding it: lsof -iTCP:5432 -sTCP:LISTEN
POSTGRES_PORT=5432

# Supabase connection string, used by scripts/migrate.sh to apply migrations to
# the deployed database. Supabase dashboard -> Project Settings -> Database ->
# Connection string -> URI. Use the SESSION string, not the pooled one:
# migrations run DDL and the transaction pooler does not support it.
# This is the full database password. Keep it in .env, which is not committed.
DATABASE_URL=

FRONTEND_PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

SUPABASE_URL=https://dpdrsyigdzadaotvhnhb.supabase.co
SUPABASE_SECRET_KEY=

# Browser-safe Auth configuration. Use the project's publishable key (or the
# legacy anon key), never SUPABASE_SECRET_KEY. NEXT_PUBLIC values are embedded
# into the Next.js browser bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=https://dpdrsyigdzadaotvhnhb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only API Discovery configuration for the Compose frontend.
GEMINI_API_KEY=
DISCOVERY_MODEL=gemini-3.5-flash-lite
