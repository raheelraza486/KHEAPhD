SUPABASE_URL=https://dpdrsyigdzadaotvhnhb.supabase.co
SUPABASE_SECRET_KEY=

# Browser-safe Auth values. The publishable key is not the server secret.
NEXT_PUBLIC_SUPABASE_URL=https://dpdrsyigdzadaotvhnhb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only API Discovery model configuration. Never use a NEXT_PUBLIC prefix.
GEMINI_API_KEY=
DISCOVERY_MODEL=gemini-3.5-flash-lite

# Stateless Discovery / Workflow request timeouts, including body reads (milliseconds).
# Inputs, files and results are kept only in the active browser page's memory.
DISCOVERY_MODEL_TIMEOUT_MS=30000
API_MATCH_TIMEOUT_MS=30000
WORKFLOW_EVALUATION_TIMEOUT_MS=60000
WORKSPACE_OVERALL_TIMEOUT_MS=90000

# Server-only partner keys for the composed Peppol invoice API
# (/api/composed/peppol-invoice). Without the beliq key the API cannot generate
# the invoice; without both B2Brouter values it stops after validation.
BELIQ_API_KEY=
B2BROUTER_API_KEY=
B2BROUTER_ACCOUNT_ID=

# Sending the validated invoice by email instead (send_via "email"). Without the
# key and the domain the API stops after validation. MAILGUN_FROM defaults to
# postmaster@<domain>; MAILGUN_BASE_URL is only needed for Mailgun's EU region
# (https://api.eu.mailgun.net). A signed-in person may email an invoice to their
# own account address, or to an address listed here, comma-separated.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
MAILGUN_BASE_URL=
MAILGUN_ALLOWED_RECIPIENTS=

# The composed PDF invoice API (/api/composed/pdf-invoice): extract, convert,
# validate under the Australian rules, send. UPBRAINS_WEBHOOK_URL is the webhook
# of the extraction flow in the client's Upbrains workspace; it carries no
# token, so the address itself is the secret, and every call spends the
# client's credits. SMARTDOCFLOW_API_KEY is the ESS validation key. Sending
# uses the B2Brouter and Mailgun values above, or Ademico over the Peppol test
# network (peppol_platform=ademico): the Basic-authentication user and password
# and the API access token Ademico issues for its TEST environment.
UPBRAINS_WEBHOOK_URL=
SMARTDOCFLOW_API_KEY=
ADEMICO_USERNAME=
ADEMICO_PASSWORD=
ADEMICO_ACCESS_TOKEN=

# One-click deployment to AWS (/api/workflows/deployments, #135): the S3 bucket
# the packaged functions and templates are uploaded to. Without it the routes
# answer 503. The server's AWS permissions come from the ECS task role (see
# lib/workflow-deploy/README.md); AWS_REGION defaults to ap-southeast-2.
WORKFLOW_ARTIFACT_BUCKET=
